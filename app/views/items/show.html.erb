<%= link_to "← Back", (request.referer.presence || root_path), class: "ghost" %>
<h1><%= @listing.title %></h1>

<div class="card">
  <div class="row">
    <div class="th" aria-hidden="true"><%= @listing.emoji %></div>
    <div class="grow">
      <div class="meta"><%= @listing.category %></div>
      <div class="meta">Pick-up area: <%= @listing.area %></div>
      <div class="meta">
        <% if @listing.sold? %>Sold
        <% elsif @listing.expired? %>Expired
        <% else %><%= pluralize(@listing.days_left, "day") %> left<% end %>
      </div>
    </div>
    <div class="price"><%= cedis(@listing.price) %></div>
  </div>
</div>

<h2>Seller</h2>
<div class="card">
  <b><%= @listing.user.display_name %></b>
  <div class="meta"><%= @listing.user.area %></div>
</div>

<% if current_user.buyer? && @listing.user_id != current_user.id && !@listing.sold? && !@listing.expired? && !@listing.user.suspended? %>
  <%# Assumes item_requests#create takes listing_id; adjust to match your controller. %>
  <%= button_to "Request this", item_requests_path, params: { listing_id: @listing.id }, class: "btn" %>
<% end %>
